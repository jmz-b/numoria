SET(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Moria: a roguelike Dungeon Crawler game | NUmoria")
SET(CPACK_PACKAGE_VERSION "${NUMORIA_VERSION_SAFE}")
SET(CPACK_PACKAGE_VERSION_MAJOR "${upstream_version_major}")
SET(CPACK_PACKAGE_VERSION_MINOR "${upstream_version_minor}")
SET(CPACK_PACKAGE_VERSION_PATCH "${upstream_version_patch}")
SET(CPACK_PACKAGE_DESCRIPTION_FILE "${PROJECT_SOURCE_DIR}/README.md")
SET(CPACK_RESOURCE_FILE_WELCOME "${PROJECT_SOURCE_DIR}/README.md")
SET(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-${NUMORIA_VERSION_SAFE}-${NUMORIA_CURSES}-${CMAKE_SYSTEM_NAME}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)

if ("${NUMORIA_CURSES}" STREQUAL "wingui")
    set(CPACK_GENERATOR "ZIP")
else ()
    set(CPACK_GENERATOR "TGZ")
endif ()

include(CPack)
