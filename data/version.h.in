// Upstream Umoria version -- used for save file and score file compatibility.
constexpr uint8_t CURRENT_VERSION_MAJOR = ${upstream_version_major};
constexpr uint8_t CURRENT_VERSION_MINOR = ${upstream_version_minor};
constexpr uint8_t CURRENT_VERSION_PATCH = ${upstream_version_patch};

// NUmoria patch revision -- bump in CMakeLists.txt when patches change.
constexpr uint8_t NUMORIA_REVISION = ${NUMORIA_REVISION};
